# Git LFS rules for large binary files
*libINET* filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.vec filter=lfs diff=lfs merge=lfs -text
*.pcap filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# Line ending rules
*.bat text eol=crlf
*.cmd text eol=crlf
*.py text eol=lf
*.sh text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.ini text eol=lf
*.ned text eol=lf
*.msg text eol=lf

# Binary files (no line ending conversion)
*.json binary
*.dat binary
*.bin binary
*.exe binary
*.so binary
*.dylib binary
*.a binary
*.lib binary
*.o binary
*.obj binary